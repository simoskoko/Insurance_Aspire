@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using OsiguranjeAspire.Web.Auth
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ITSOsiguranje</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested" aria-hidden="true"></span> Weather
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized Context="authState">
                @{
                    var roleId = authState.User.FindFirst("roleId")?.Value;
                }

                @if (roleId is "1" or "2")
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="polise">
                            <span class="bi bi-list-nested" aria-hidden="true"></span> Polise zaposlenih
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="polisepozaposlenom">
                        <span class="bi bi-list-nested" aria-hidden="true"></span> Moje Polise
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized Context="authState">
                @{
                    var roleId = authState.User.FindFirst("roleId")?.Value;
                }

                @if (roleId == "2" || roleId == "3")
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="pregledpolise/nova">
                            <span class="bi bi-plus-square"></span> Nova polisa
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <button type="button" class="nav-link btn btn-link p-0" @onclick="Logout">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Odjava
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Prijava
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private void Logout()
    {
        if (AuthenticationStateProvider is SessionAuthenticationStateProvider session)
            session.ClearUser();

        Navigation.NavigateTo("/login");
    }
}
