@page "/login"
@using System.Net.Http.Json
@using OsiguranjeAspire.Contracts.Korisnik
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Prijava</h3>

<div class="mb-3">
    <label>Korisničko ime</label>
    <input class="form-control" @bind="model.Username" />
</div>

<div class="mb-3">
    <label>Lozinka</label>
    <input class="form-control" type="password" @bind="model.Password" />
</div>

<button class="btn btn-primary" @onclick="LoginAsync" disabled="@isLoading">
    @(isLoading ? "Prijava..." : "Prijavi se")
</button>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="text-danger mt-3">@error</div>
}

@code {
    private LoginRequestDto model = new();
    private bool isLoading;
    private string? error;

    private async Task LoginAsync()
    {
        error = null;
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("auth/login", model);

            if (!response.IsSuccessStatusCode)
            {
                error = "Pogrešno korisničko ime ili lozinka.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

            if (result is null || string.IsNullOrWhiteSpace(result.Token))
            {
                error = "Token nije vraćen.";
                return;
            }

            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);

            Nav.NavigateTo("/");
        }
        catch
        {
            error = "Greška pri prijavi.";
        }
        finally
        {
            isLoading = false;
        }
    }
}