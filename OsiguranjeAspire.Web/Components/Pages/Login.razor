@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Prijava</PageTitle>

<div class="login-shell">
    <section class="login-panel" aria-labelledby="login-title">
        <div class="login-header">
            <p>ITSOsiguranje</p>
            <h1 id="login-title">Prijava</h1>
        </div>

        @if (showError)
        {
            <div class="alert alert-danger" role="alert">
                Pogrešno korisničko ime ili lozinka.
            </div>
        }

        <form method="post" action="/auth/login" autocomplete="on">
            <div class="mb-3">
                <label class="form-label" for="username">Korisničko ime</label>
                <input id="username"
                       name="username"
                       class="form-control"
                       autocomplete="username"
                       required
                       autofocus />
            </div>

            <div class="mb-4">
                <label class="form-label" for="password">Lozinka</label>
                <input id="password"
                       name="password"
                       class="form-control"
                       type="password"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Prijavi se</button>
        </form>
    </section>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #f4f6f8;
    }

    .login-panel {
        width: min(100%, 420px);
        padding: 32px;
        background: #fff;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        box-shadow: 0 16px 36px rgba(31, 41, 55, 0.08);
    }

    .login-header {
        margin-bottom: 24px;
    }

    .login-header p {
        margin: 0 0 4px;
        color: #8b1e1e;
        font-weight: 700;
        letter-spacing: 0;
    }

    .login-header h1 {
        margin: 0;
        color: #202428;
        font-size: 1.75rem;
        font-weight: 650;
    }

    .form-label {
        color: #33383f;
        font-weight: 600;
    }

    .form-control {
        min-height: 44px;
        border-radius: 6px;
    }

    .btn-primary {
        min-height: 44px;
        background-color: #8b1e1e;
        border-color: #8b1e1e;
        border-radius: 6px;
        font-weight: 700;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        background-color: #731818;
        border-color: #731818;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool showError => Error == "1";
}
