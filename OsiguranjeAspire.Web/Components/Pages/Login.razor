@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Prijava</PageTitle>

<div class="login-shell">
    <section class="login-panel" aria-labelledby="login-title">
        <div class="login-header">
            <p>ITSOsiguranje</p>
            <h1 id="login-title">Prijava</h1>
        </div>

        @if (showError)
        {
            <div class="alert alert-danger" role="alert">
                Pogrešno korisničko ime ili lozinka.
            </div>
        }

        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" autocomplete="on">
            <div class="mb-3">
                <label class="form-label" for="username">Korisničko ime</label>
                <input id="username"
                       class="form-control"
                       @bind="username"
                       autocomplete="username"
                       required
                       autofocus />
            </div>

            <div class="mb-4">
                <label class="form-label" for="password">Lozinka</label>
                <input id="password"
                       class="form-control"
                       type="password"
                       @bind="password"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Prijavi se</button>

            @if (isLocalhost)
            {
                <button type="button" class="btn btn-secondary w-100 mt-3" @onclick="HandleLocalBypass">
                    Dev: Bypass Login (Localhost)
                </button>
            }
        </form>
    </section>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: #f4f6f8;
    }

    .login-panel {
        width: min(100%, 420px);
        padding: 32px;
        background: #fff;
        border: 1px solid #dfe3e8;
        border-radius: 8px;
        box-shadow: 0 16px 36px rgba(31, 41, 55, 0.08);
    }

    .login-header {
        margin-bottom: 24px;
    }

    .login-header p {
        margin: 0 0 4px;
        color: #8b1e1e;
        font-weight: 700;
        letter-spacing: 0;
    }

    .login-header h1 {
        margin: 0;
        color: #202428;
        font-size: 1.75rem;
        font-weight: 650;
    }

    .form-label {
        color: #33383f;
        font-weight: 600;
    }

    .form-control {
        min-height: 44px;
        border-radius: 6px;
    }

    .btn-primary {
        min-height: 44px;
        background-color: #8b1e1e;
        border-color: #8b1e1e;
        border-radius: 6px;
        font-weight: 700;
    }

    .btn-primary:hover,
    .btn-primary:focus {
        background-color: #731818;
        border-color: #731818;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
        color: white;
        border-radius: 6px;
        font-weight: 600;
    }

    .btn-secondary:hover,
    .btn-secondary:focus {
        background-color: #5a6268;
        border-color: #545b62;
    }

    .mt-3 {
        margin-top: 1rem;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
    private string username = string.Empty;
    private string password = string.Empty;
    private bool loginFailed;
    private bool isLocalhost;

    private bool showError => Error == "1" || loginFailed;

    [Microsoft.AspNetCore.Components.Inject]
    private OsiguranjeAspire.Web.Services.AuthApi? auth { get; set; }

    [Microsoft.AspNetCore.Components.Inject]
    private Microsoft.AspNetCore.Components.NavigationManager? Navigation { get; set; }

    protected override void OnInitialized()
    {
        if (Navigation != null)
        {
            var uri = new Uri(Navigation.Uri);
            isLocalhost = uri.Host == "localhost" || uri.Host == "127.0.0.1" || uri.Host.StartsWith("localhost:");
        }
    }

    private async System.Threading.Tasks.Task HandleSubmit()
    {
        loginFailed = false;
        if (auth is null || Navigation is null)
        {
            loginFailed = true;
            return;
        }

        var result = await auth.LoginAsync(username, password);
        if (string.IsNullOrWhiteSpace(result))
        {
            loginFailed = true;
            return;
        }

        // Cookie is set server-side by the auth endpoint, just navigate
        Navigation.NavigateTo("/home", true);
    }

    private async System.Threading.Tasks.Task HandleLocalBypass()
    {
        loginFailed = false;
        if (auth is null || Navigation is null)
        {
            loginFailed = true;
            return;
        }

        // Use credentials from the form
        var result = await auth.LoginAsync(username, password);
        if (string.IsNullOrWhiteSpace(result))
        {
            loginFailed = true;
            return;
        }

        Navigation.NavigateTo("/home", true);
    }
}
