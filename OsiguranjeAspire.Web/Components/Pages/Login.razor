@page "/login"
@using System.Net.Http.Json
@using OsiguranjeAspire.Contracts.Korisnik
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Prijava</PageTitle>
<h1>LOGIN TEST</h1>
<div class="login-page">
    <div class="login-card">
        <h1>Prijava</h1>

        <div class="form-group">
            <label for="username">Korisničko ime</label>
            <input id="username" class="form-control" @bind="model.Username" />
        </div>

        <div class="form-group">
            <label for="password">Lozinka</label>
            <input id="password" class="form-control" type="password" @bind="model.Password" />
        </div>

        <button class="btn btn-primary login-btn" @onclick="LoginAsync" disabled="@isLoading">
            @(isLoading ? "Prijava..." : "Prijavi se")
        </button>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="login-error">@error</div>
        }
    </div>
</div>

<style>
    .login-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
        background-color: #f5f6f8;
    }

    .login-card {
        width: 100%;
        max-width: 460px;
        background: white;
        padding: 32px;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

        .login-card h1 {
            margin-bottom: 24px;
            font-size: 2rem;
            font-weight: 600;
            text-align: center;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }

    .form-control {
        width: 100%;
        height: 44px;
        padding: 10px 12px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        font-size: 1rem;
        box-sizing: border-box;
    }

    .login-btn {
        width: 100%;
        height: 44px;
        margin-top: 8px;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
    }

    .login-error {
        margin-top: 16px;
        padding: 10px 12px;
        border-radius: 8px;
        background-color: #f8d7da;
        color: #842029;
        font-size: 0.95rem;
    }
</style>

@code {
    private LoginRequestDto model = new();
    private bool isLoading;
    private string? error;

    private async Task LoginAsync()
    {
        error = null;
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("auth/login", model);

            if (!response.IsSuccessStatusCode)
            {
                error = "Pogrešno korisničko ime ili lozinka.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponseDto>();

            if (result is null || string.IsNullOrWhiteSpace(result.Token))
            {
                error = "Token nije vraćen.";
                return;
            }

            await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
            Nav.NavigateTo("/");
        }
        catch
        {
            error = "Greška pri prijavi.";
        }
        finally
        {
            isLoading = false;
        }
    }
}